{
  "name": "jujitsu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src && npm run format",
    "lint:strict": "oxlint --deny-warnings src",
    "format": "oxfmt --write . '!**/*.md'",
    "format:check": "oxfmt --check . '!**/*.md'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@tabler/icons-react": "^3.40.0",
    "@tailwindcss/postcss": "^4.2.2",
    "next": "16.3.8",
    "postcss": "8.5.25",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.57.0",
    "typescript": "5.7.2"
  }
}
